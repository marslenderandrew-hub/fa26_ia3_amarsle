{
  "name": "andrew-marslender-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Personal portfolio of Andrew Marslender — React + Vite front end served by an Express server on Google Cloud Run.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c yellow,cyan \"node --watch server/server.js\" \"vite\"",
    "build": "vite build",
    "start": "NODE_ENV=production node server/server.js",
    "preview": "npm run build && npm start"
  },
  "dependencies": {
    "express": "^4.21.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.1",
    "postcss": "^8.4.47",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "tailwindcss": "^3.4.14",
    "vite": "^5.4.10"
  }
}
